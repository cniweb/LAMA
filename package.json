{
  "name": "lama-online-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "worker",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=frontend && npm run build --workspace=worker",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev --workspace=worker"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}
