{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lama",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "BEE-4ChVOeLhYRwkB7c8t-Aa7EBPfC7P0xha4HE2DbH0NygSpGKR-Lyx2ERqX-760EYogDelXyclNu9HPwtmGyY",
    "VAPID_PRIVATE_KEY": "SCCGL34q3xkn26_WaBBfNUcDucHSwDK1-1gsELE7TKc",
    "VAPID_SUBJECT": "mailto:lama@example.com"
  }
}
